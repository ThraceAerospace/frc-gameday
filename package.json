{
  "name": "frc-gameday",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@fieldview/web",
    "build": "npm run build --workspace=@fieldview/web",
    "start": "npm run start --workspace=@fieldview/web",
    "lint": "eslint",
    "generate:tba-types": "openapi-typescript https://www.thebluealliance.com/swagger/api_v3.json -o apps/web/src/lib/tba/generated.ts",
    "predev": "npm run generate:tba-types && npm run generate:statbotics-types",
    "prebuild": "npm run generate:tba-types && npm run generate:statbotics-types",
    "generate:statbotics-types": "node scripts/generate-statbotics-types.mjs"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "openapi-typescript": "^7.13.0"
  }
}
